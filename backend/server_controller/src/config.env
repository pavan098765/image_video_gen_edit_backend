# Fixed fleet (windowed scheduler): enables omni multi templates, pod TTL/drain, slot cap, preferred machines.
# Comma-separated QuickPod machine IDs (no spaces). run_cache_refresh.py: when set, only these machines refresh.
# FIXED_FLEET_MAX_PODS = hard cap on concurrent individual pods (offers do not expose stable GPU identity).
# FIXED_FLEET_GPU_TIERS: pipe-separated groups, highest-preference group first (here: 5090 | 4090 | 3090).
# FIXED_FLEET_STRICT_MACHINES=true: never create on machines outside FIXED_FLEET_MACHINE_IDS (no global fallback).
SCHEDULER_MODE=fixed_fleet_windowed
FIXED_FLEET_MAX_PODS=8
FIXED_FLEET_MACHINE_IDS=14780,14891,275,283,300,461,334,428,14926,348
FIXED_FLEET_GPU_TIERS=14780,14891,275,283|300,461|334,428,14926,348
FIXED_FLEET_STRICT_MACHINES=true
# Optional: MACHINE_CACHE_PATH=/absolute/path/to/machine_cache.json on the VM
# Example: FIXED_FLEET_MACHINE_IDS=300,283,461
# FLEET_OMNI_TEMPLATE_PRIORITY: comma-separated model keys (same keys as *_MULTI_TEMPLATE_UUID).
# When creating a pod for shared-bake omni models (basic_utils, aurasrv2, swin2sr, video_upscaler, face_enhancer, glm_ocr),
# the controller picks the first non-empty template UUID from this order. Rebuild all omni multi images after prep so GLM weights are shared-baked.
# Deterministic cold-start order: prefer flux_klein (fastest HF bake), then z_image_turbo, then qwen_image_edit.
FLEET_OMNI_TEMPLATE_PRIORITY=flux_klein,z_image_turbo,qwen_image_edit_2511_rapid_aio,sdxl_t2i,diffusers_outpaint

