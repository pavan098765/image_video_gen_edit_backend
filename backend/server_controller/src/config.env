# controller/config.env
# FastAPI host/port (internal)
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=8080

# Public URL where workers can reach the controller. MUST be reachable from Salad workers.
# Example: https://controller.example.com
CONTROLLER_PUBLIC_URL=https://your-controller-public-domain-or-ip

# Salad API config
SALAD_API_KEY=your_salad_api_key_here
SALAD_ORGANIZATION=your_salad_org_slug
SALAD_PROJECT=your_salad_project_slug
SALAD_GPU_CLASS_IDS=rtx-5090-id  # CSV or single id

SALAD_WORKER_IMAGE_PREFIX=ghcr.io/your-org/worker

# SQLite DB path
DB_PATH=./controller.db

# Worker idle timeout (seconds) - worker will be removed if idle this long
WORKER_IDLE_TIMEOUT=10

# How long to wait for a newly spawned worker to register (seconds)
WORKER_REGISTRATION_TIMEOUT=180

# Shared secret for HMAC signing between controller and workers
CONTROLLER_SHARED_SECRET=replace-with-a-very-secret-string

# Cloudflare R2 credentials (optional if controller will presign uploads)
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=your-results-bucket
R2_ACCESS_KEY_ID=R2KEY
R2_SECRET_ACCESS_KEY=R2SECRET

# Tenacity / retry tuning
SALAD_RETRY_ATTEMPTS=5
SALAD_RETRY_MIN=2
SALAD_RETRY_MAX=30

# Optional: controller API keys (comma separated) for admin/API usage
CONTROLLER_API_KEYS=your_api_key_here
