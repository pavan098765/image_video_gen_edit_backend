# =============================================================================
# Cloudflare D1 Database Configuration
# =============================================================================
# When these are set, the server uses Cloudflare D1 instead of local SQLite.
# Leave empty/unset to use local SQLite database.

# Cloudflare Account ID (found in Cloudflare dashboard URL)
CF_ACCOUNT_ID=9ad1ad9de5a81cf253aa25267a464c3f

# D1 Database ID (found in D1 dashboard after creating database)
CF_D1_DATABASE_ID=f42c2b67-6457-4fd3-be85-298c9574342d

# Cloudflare API Token with D1 permissions
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Account > D1 > Edit
CF_API_TOKEN=HBJyhVVL4mR979hpv5QV9MKyB1tV0wCYKQU7HisA

# Set to 'true' to force D1 usage (error if D1 config incomplete)
# Set to 'false' or leave empty for auto-detect (use D1 if configured, else SQLite)
USE_D1_DATABASE=false

ADGEM_POSTBACK_KEY=4jg79i9fa9lg74g9lcj336g1
ADGEM_WEBHOOK_SECRET=07gdnhc57j961mkl5k4c6g9c

# =============================================================================
# DB Cleanup Service (in-process, runs weekly)
# =============================================================================
# DB_CLEANUP_INTERVAL_DAYS=7    # How often to run cleanup (default: 7)
# DB_CLEANUP_RETENTION_DAYS=7   # Delete rows older than this (default: 7)
# DB_CLEANUP_BATCH_SIZE=500     # Rows per batch (default: 500)

# =============================================================================
# Cache Refresh Service (run_cache_refresh.py - invoke via cron; enforces min interval below)
# =============================================================================
# CACHE_REFRESH_MIN_INTERVAL_DAYS=20      # Skip if state file newer than this (default 20)
# REFRESH_RUN_INTERVAL_DAYS=20            # Alias for CACHE_REFRESH_MIN_INTERVAL_DAYS
# CACHE_REFRESH_STATE_PATH=               # Default: src/.cache_refresh_last_run
# CACHE_REFRESH_FORCE=1                   # Set to force a run ignoring min interval
# REFRESH_REGISTRATION_TIMEOUT_MINUTES=8  # Max wait for worker registration
# REFRESH_POD_KEEP_ALIVE_MINUTES=5        # Keep pod alive after registration (or download in progress)
# REFRESH_MAX_ITEMS_PER_RUN=5            # Cap (machine, model) pairs per run
# REFRESH_MAX_CONCURRENT=1                # Max concurrent refresh pods (optional)

# =============================================================================
# External GPU providers (after Quickpod has no rentable machine)
# Search order: Quickpod, then GPU_PROVIDER_ORDER (default runpod,vast,salad).
# =============================================================================
# GPU_PROVIDERS_ENABLED=true
# GPU_PROVIDER_ORDER=runpod,vast,salad
# RUNPOD_API_KEY=
# RUNPOD_CLOUD=COMMUNITY
# VAST_API_KEY=
# SALAD_API_KEY=
# SALAD_ORGANIZATION=
# SALAD_PROJECT=
# SALAD_CPU=8
# SALAD_MEMORY_MB=32768
