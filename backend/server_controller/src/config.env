CONTROLLER_SHARED_SECRET=SECRETKEY
# Omni multi worker HTTP payloads: Fernet envelope + HMAC. Set to 1 on server and on pods (must match).
# Optional WORKER_PAYLOAD_ENCRYPTION_KEY=Fernet.generate_key() output; else key is derived from CONTROLLER_SHARED_SECRET.
WORKER_TRANSPORT_CRYPTO=1
ASSET_PROMPT_VLM_ENABLED=1
GEMINI_DIRECTOR_URL=https://kala-gemini-director.pavanalur3.workers.dev/v1/generate
GEMINI_DIRECTOR_MODEL=gemini-3.5-flash-lite
