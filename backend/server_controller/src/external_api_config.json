      "provider": {
        "type": "fal",
        "model_id": "fal-ai/birefnet",
        "api_key_env": "FAL_KEY"
      },
      "required_params": [
        "image_url"
      ],
      "param_map": {
        "image_url": {
          "source": "params.init_image",
          "transform": "media_input"
        },
        "model": {
          "value": "General Use (Light)"
        },
        "refine_foreground": {
          "value": true
        },
        "output_format": {
          "value": "png"
        }
      },
      "upscale_map": {
        "when_true": {
          "set": {
            "operating_resolution": "2048x2048"
          }
        },
        "when_false": {
          "set": {
            "operating_resolution": "1024x1024"
          }
        }
      },
      "response_map": {
        "result_url_path": "image.url",
        "error_path": "error.message"
      }
    },
