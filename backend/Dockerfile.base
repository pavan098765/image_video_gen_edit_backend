# ============================================================
# BASE DEPS DOCKERFILE - PyPI/GitHub Based (No Local Wheels)
# Python 3.11 + PyTorch 2.8+ + CUDA 12.8
# Supports: RTX 4090 (SM 8.9), RTX 5090 (SM 12.0/Blackwell)
# ============================================================
#
# Build Command:
#   docker build -t pavanalur3/deps-base-new:py311-cu128 .
#
# ============================================================

# =============================================================
# ⚙️ CONFIGURATION - Edit these values to customize your build
# =============================================================
ARG PYTHON_VERSION=3.11
ARG CUDA_SHORT=128
ARG CUDA_VERSION=12.8

# Optional Components (set to "true" or "false")
ARG INSTALL_REALESRGAN=true
ARG INSTALL_NUNCHAKU=true

# Nunchaku settings (only used if INSTALL_NUNCHAKU=true)
ARG NUNCHAKU_VERSION=1.2.1
ARG NUNCHAKU_TORCH_VERSION=2.10
# =============================================================

# =========================
# Stage 1: Builder
# =========================
FROM python:${PYTHON_VERSION}-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive
ARG CUDA_SHORT
ARG CUDA_VERSION
ARG INSTALL_NUNCHAKU
ARG INSTALL_REALESRGAN
ARG NUNCHAKU_VERSION
ARG NUNCHAKU_TORCH_VERSION

# Build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget curl ca-certificates \
    build-essential cmake ninja-build \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip wheel setuptools

WORKDIR /deps

# ============================================================
# PyTorch + CUDA 12.8 (from official PyTorch index)
# ============================================================
# Install from PyPI - uses cu128 index for CUDA 12.8
# Falls back to cu124 if cu128 wheels not available yet
RUN echo "📦 Installing PyTorch from PyPI (CUDA 12.8)..." && \
    pip install --no-cache-dir \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu${CUDA_SHORT} \
    || { \
        echo "⚠️ cu128 not available, trying cu124 (compatible with CUDA 12.8)..."; \
        pip install --no-cache-dir \
            torch torchvision torchaudio \
            --index-url https://download.pytorch.org/whl/cu124; \
    } && rm -rf /root/.cache/pip /tmp/*

# Verify PyTorch installation
RUN python -c "import torch; print(f'✅ PyTorch {torch.__version__}, CUDA available: {torch.cuda.is_available()}')"

# ============================================================
# Core ML/AI Dependencies (Version Pinned)
# ============================================================
RUN pip install --no-cache-dir \
    numpy \
    accelerate>=1.0.0 \
    diffusers \
    transformers>=4.45.0 \
    huggingface-hub>=0.25.0 \
    safetensors>=0.4.0 \
    tokenizers>=0.20.0 \
    sentencepiece>=0.2.0 \
    peft>=0.12.0 \
    && rm -rf /root/.cache/pip /tmp/*

# ============================================================
# Web Framework & Utilities
# ============================================================
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    uvloop \
    httpx \
    requests \
    tenacity \
    pydantic>=2.0.0 \
    && rm -rf /root/.cache/pip /tmp/*

# ============================================================
# Image Processing Libraries
# ============================================================
RUN pip install --no-cache-dir \
    pillow>=12.0.0 \
    opencv-python-headless \
    imageio \
    imageio-ffmpeg \
    tqdm \
    && rm -rf /root/.cache/pip /tmp/*

# ============================================================
# Specialized ML Packages
# ============================================================
RUN pip install --no-cache-dir \
    simple-lama-inpainting \
    aura-sr \
    gfpgan>=1.3.8 \
    gguf>=0.12.0 \
    ftfy \
    basicsr>=1.4.2 \
    facexlib>=0.3.0 \
    && rm -rf /root/.cache/pip /tmp/*

# ============================================================
# Real-ESRGAN (from GitHub - optional)
# ============================================================
RUN if [ "$INSTALL_REALESRGAN" = "true" ]; then \
        echo "📦 Installing Real-ESRGAN from GitHub..."; \
        pip install --no-cache-dir \
            git+https://github.com/xinntao/Real-ESRGAN.git@master; \
    else \
        echo "⏭️ Skipping Real-ESRGAN (set INSTALL_REALESRGAN=true to include)"; \
    fi && rm -rf /root/.cache/pip /tmp/*

# ============================================================
# Nunchaku INT4/FP4 Quantization (optional)
# Supports: RTX 4090 (SM 8.9), RTX 5090 (SM 12.0/Blackwell)
# GitHub: https://github.com/nunchaku-tech/nunchaku
# ============================================================
# Build-time CUDA arch specification for 4090 + 5090
ENV TORCH_CUDA_ARCH_LIST="8.9;12.0" \
    TORCH_NVCC_FLAGS="--disable-gpu-arch-detection" \
    NUNCHAKU_INSTALL_MODE=LIMITED

RUN if [ "$INSTALL_NUNCHAKU" = "true" ]; then \
        echo "📦 Installing Nunchaku v${NUNCHAKU_VERSION} for INT4 quantization..."; \
        # Construct wheel URL for nunchaku-tech releases
        WHEEL_URL="https://github.com/nunchaku-tech/nunchaku/releases/download/v${NUNCHAKU_VERSION}/nunchaku-${NUNCHAKU_VERSION}+cu${CUDA_VERSION}torch${NUNCHAKU_TORCH_VERSION}-cp311-cp311-linux_x86_64.whl"; \
        echo "Trying wheel: ${WHEEL_URL}"; \
        pip install --no-cache-dir "${WHEEL_URL}" \
        || { \
            echo "⚠️ Pre-built wheel not found, trying PyPI..."; \
            pip install --no-cache-dir nunchaku; \
        } \
        || echo "❌ Nunchaku installation failed - check compatible version at https://github.com/nunchaku-tech/nunchaku/releases"; \
    else \
        echo "⏭️ Skipping Nunchaku (set INSTALL_NUNCHAKU=true to include)"; \
    fi && rm -rf /root/.cache/pip /tmp/*

# ============================================================
# Cleanup build artifacts
# ============================================================
RUN find /opt/venv -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    rm -rf /root/.cache /tmp/*

# =========================
# Stage 2: Runtime (Minimal)
# =========================
FROM python:${PYTHON_VERSION}-slim

ARG PYTHON_VERSION=3.11

# Copy virtual environment
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

ENV DEBIAN_FRONTEND=noninteractive

# Minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget curl ca-certificates \
    # OpenCV dependencies
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    # C++ runtime
    libgomp1 \
    libstdc++6 \
    # SSL/crypto
    libssl3 \
    libffi8 \
    # Image format support
    libtiff6 \
    libjpeg62-turbo \
    libpng16-16 \
    libwebp7 \
    libopenjp2-7 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Strip debug symbols from shared libraries
# RUN find /opt/venv -name "*.so" -exec strip --strip-unneeded {} + 2>/dev/null || true

WORKDIR /app

# ============================================================
# Environment Variables
# ============================================================
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # PyTorch memory optimization
    PYTORCH_CUDA_ALLOC_CONF="garbage_collection_threshold:0.6,max_split_size_mb:512,expandable_segments:True" \
    # HuggingFace cache
    HF_HOME="/app/.cache/huggingface" \
    TRANSFORMERS_CACHE="/app/.cache/huggingface/transformers" \
    # CUDA architectures for runtime JIT compilation
    TORCH_CUDA_ARCH_LIST="8.9;12.0"

# Labels
LABEL maintainer="QuickPod ML Team" \
      python.version="${PYTHON_VERSION}" \
      cuda.version="12.8" \
      description="Base ML inference image - PyTorch + CUDA 12.8 + Diffusers"

# No ENTRYPOINT (workers define their own)
