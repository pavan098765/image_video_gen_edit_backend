# ============================================================
# SMALL FINAL IMAGE – QUICKPOD SAFE
# Python 3.11 + CUDA 12.8 runtime
# ============================================================

# =========================
# Stage 1: Builder
# =========================
FROM nvidia/cuda:12.8.0-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/opt/venv/bin:$PATH"

# ---- System build deps ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-dev python3-pip \
    git build-essential cmake ninja-build \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# ---- Virtualenv ----
RUN python3.11 -m venv /opt/venv

# ---- Upgrade pip ----
RUN pip install --no-cache-dir -U pip wheel setuptools

WORKDIR /deps

# ---- PyTorch CUDA 12.8 ----
RUN pip install --no-cache-dir \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu128

# ---- NVIDIA runtime wheels ONLY ----
RUN pip install --no-cache-dir \
    nvidia-cublas-cu12 \
    nvidia-cudnn-cu12 \
    nvidia-cuda-runtime-cu12 \
    nvidia-cusolver-cu12 \
    nvidia-cusparse-cu12 \
    nvidia-nccl-cu12 \
    nvidia-nvtx-cu12

# ---- Core runtime deps ----
RUN pip install --no-cache-dir \
    numpy \
    accelerate==1.10.1 \
    diffusers==0.35.1 \
    transformers==4.56.2 \
    huggingface-hub==0.35.0 \
    safetensors==0.6.2 \
    tokenizers==0.22.1 \
    sentencepiece==0.2.1 \
    fastapi uvicorn uvloop httpx \
    pillow opencv-python tqdm

# ============================================================
# NUNCHAKU (RTX 4090 SAFE)
# ============================================================
ENV TORCH_CUDA_ARCH_LIST="8.9"
ENV TORCH_NVCC_FLAGS="--disable-gpu-arch-detection"
ENV CUDA_VISIBLE_DEVICES=""
ENV NUNCHAKU_INSTALL_MODE=LIMITED

RUN pip install --no-cache-dir \
    https://github.com/nunchaku-tech/nunchaku/releases/download/v1.0.2/nunchaku-1.0.2+torch2.10-cp311-cp311-linux_x86_64.whl

# =========================
# Stage 2: Runtime (SMALL)
# =========================
FROM nvidia/cuda:12.8.0-runtime-ubuntu22.04

ENV PATH="/opt/venv/bin:$PATH"
ENV DEBIAN_FRONTEND=noninteractive

# ---- Minimal OS libs ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    ca-certificates \
    libgl1 libglib2.0-0 libgomp1 \
    libstdc++6 libssl3 libffi8 \
    && rm -rf /var/lib/apt/lists/*

# ---- Copy venv only ----
COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

ENV PYTORCH_ALLOC_CONF="garbage_collection_threshold:0.6,max_split_size_mb:512"

# No ENTRYPOINT (QuickPod compatible)
